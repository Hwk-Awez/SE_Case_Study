# =====================================================================
# Software Component Cataloguing System - Multi-Database Environment
# =====================================================================

# Django Settings
SECRET_KEY=django-insecure-40x648g+k985&+kd3!9&orgkt-plj0%qz%6++g@nr69&*p12ed
DEBUG=True

# =====================================================================
# Database 1: Authentication & Login Database
# =====================================================================
# Managed automatically via Python's built-in SQLite engine (auth_users.sqlite3)
# Stores: Users, Sessions, Groups, and Admin authentication.

# =====================================================================
# Database 2: Component Catalogue Database (Supabase)
# =====================================================================
# Dedicated database for components, categories, reuse records, and analytics.
# Leave empty to use local database (supabase_catalogue.sqlite3).
# To connect to live Supabase PostgreSQL:
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# =====================================================================
# Semantic Vector Search (Pinecone & Embeddings)
# =====================================================================
# Optional: If left blank, the application automatically uses the keyword fallback engine.
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=component-catalog
EMBEDDING_API_KEY=
